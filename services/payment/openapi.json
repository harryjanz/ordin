{
  "openapi": "3.1.0",
  "info": {
    "title": "Ordin — Payment Service",
    "description": "Serviço de pagamentos da plataforma Ordin.\n\nIntegra com providers TEF/PIX via `IPaymentProvider`. No Sprint 3: **MockProvider** (padrão) e **PayGoProvider** (ControlPay Webservice).\n\nCredenciais são obtidas do `company-service` por empresa e ambiente — nunca globais.\n\n**Autenticação:** todos os endpoints exigem `Authorization: Bearer <token>`.\n\n**Métodos aceitos:** `credit`, `debit`, `pix`, `voucher`.",
    "version": "2.0.0"
  },
  "paths": {
    "/payments": {
      "get": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Listar transações da empresa",
        "operationId": "list_payments_payments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentListOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Processar pagamento TEF/PIX",
        "operationId": "create_payment_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Pagamento aprovado ou recusado (ver campo `ok`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApprovedOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/payments/{tx_id}/cancel": {
      "post": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Cancelar transação aprovada",
        "operationId": "cancel_payment_payments__tx_id__cancel_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tx_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tx Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOut"
                }
              }
            }
          },
          "400": {
            "description": "Transação não está no status `approved`"
          },
          "404": {
            "description": "Transação não encontrada"
          },
          "422": {
            "description": "Cancelamento PayGo permitido apenas no mesmo dia"
          }
        }
      }
    },
    "/payments/test-connection": {
      "post": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Testar conexão com a máquina de pagamento (R$ 0,01 auto-cancelado)",
        "operationId": "test_connection_payments_test_connection_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestConnectionOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/payments/{tx_id}/status": {
      "get": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Consultar status de pagamento PIX (polling do totem)",
        "operationId": "get_payment_status_payments__tx_id__status_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tx_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tx Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{tx_id}": {
      "delete": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Cancelar PIX pendente (timeout ou desistência do cliente)",
        "operationId": "delete_payment_payments__tx_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tx_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tx Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/webhook": {
      "post": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Webhook de notificações (MP PIX, MP Point, PayGo)",
        "description": "Recebe notificações push dos provedores de pagamento.\n\n**Mercado Pago:** `?source=mercadopago` (padrão). Valida `x-signature` se `MP_WEBHOOK_SECRET` estiver configurado. Suporta `type=payment` (PIX) e `type=point_integration_ipn` (MP Point cartão).\n\n**PayGo:** `?source=paygo`. Estrutura a confirmar com ControlPay Webservice.\n\nSempre retorna HTTP 200 para não bloquear reentregas do provider.",
        "operationId": "payment_webhook_payments_webhook_post",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "mercadopago",
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Healthcheck",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelIn": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "default": "Cancelamento solicitado"
          }
        },
        "type": "object",
        "title": "CancelIn"
      },
      "CancelOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "title": "CancelOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "title": "HealthOut"
      },
      "ItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "name",
          "qty",
          "unit_price"
        ],
        "title": "ItemIn"
      },
      "PaymentApprovedOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "nsu": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nsu"
          },
          "authorization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization"
          },
          "order_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Ref"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "qr_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Code"
          },
          "qr_code_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Code Base64"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "transaction_id",
          "status"
        ],
        "title": "PaymentApprovedOut"
      },
      "PaymentIn": {
        "properties": {
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemIn"
            },
            "type": "array",
            "title": "Items"
          },
          "cpf": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpf"
          },
          "tef_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tef Number"
          }
        },
        "type": "object",
        "required": [
          "order_ref",
          "method",
          "amount",
          "items"
        ],
        "title": "PaymentIn"
      },
      "PaymentListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PaymentListOut"
      },
      "PaymentStatusOut": {
        "properties": {
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "qr_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Code"
          },
          "qr_code_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Code Base64"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "status"
        ],
        "title": "PaymentStatusOut"
      },
      "TestConnectionOut": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "success",
          "detail"
        ],
        "title": "TestConnectionOut"
      },
      "TransactionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "nsu": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nsu"
          },
          "authorization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_ref",
          "method",
          "amount",
          "status",
          "provider",
          "created_at"
        ],
        "title": "TransactionOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WebhookOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "WebhookOut"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Pagamentos",
      "description": "Processamento de pagamentos via IPaymentProvider (MockProvider ou PayGoProvider). Ao aprovar, notifica o `order-service` e publica evento no broker."
    }
  ]
}