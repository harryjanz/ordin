            },
            "type": "array",
            "title": "Series"
          },
          "by_terminal": {
            "items": {
              "$ref": "#/components/schemas/TerminalBreakdown"
            },
            "type": "array",
            "title": "By Terminal"
          },
          "by_method": {
            "items": {
              "$ref": "#/components/schemas/MethodBreakdown"
