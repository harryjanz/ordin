{
  "openapi": "3.1.0",
  "info": {
    "title": "Ordin — Auth Service",
    "description": "Serviço de autenticação da plataforma Ordin.\n\nEmite JWTs com `role` (`admin`, `cashier`, `kiosk`) e `company_id` extraído das credenciais. Todos os demais serviços validam o token JWT gerado aqui.\n\n**Rate limiting:** 5 tentativas erradas de PIN bloqueiam o IP por 15 minutos.\n\n**Tokens:**\n- `admin` / `cashier`: access 15 min + refresh 7 dias (com rotação)\n- `kiosk`: access 4 horas, sem refresh",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/validate-pin": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Validar PIN da empresa",
        "description": "Valida o PIN de uma empresa sem gerar token. Usado pelo frontend para feedback antes de selecionar terminal.",
        "operationId": "validate_pin_auth_validate_pin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidatePinReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatePinOut"
                }
              }
            }
          },
          "401": {
            "description": "PIN inválido"
          },
          "429": {
            "description": "Rate limit atingido — IP bloqueado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/pin-login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login de totem via PIN",
        "description": "Login para totens de autoatendimento. Retorna JWT com `role: kiosk` e validade de 4 horas (sem refresh).",
        "operationId": "pin_login_auth_pin_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinLoginReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KioskTokenOut"
                }
              }
            }
          },
          "401": {
            "description": "PIN ou terminal inválido"
          },
          "429": {
            "description": "Rate limit atingido — IP bloqueado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login de administrador ou operador",
        "description": "Login com email + senha para roles `admin` e `cashier`. Retorna access token + refresh token com rotação.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "429": {
            "description": "Rate limit atingido"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Renovar access token",
        "description": "Rotaciona o refresh token: invalida o token atual e emite um novo par access + refresh.",
        "operationId": "refresh_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Token revogado ou expirado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Logout — revogar refresh token",
        "description": "Revoga o refresh token informado. O access token expira naturalmente no TTL.",
        "operationId": "logout_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Healthcheck",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "plan": {
            "type": "string",
            "title": "Plan"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "plan"
        ],
        "title": "CompanyInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "redis"
        ],
        "title": "HealthOut"
      },
      "KioskTokenOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyInfo"
          },
          "terminal": {
            "$ref": "#/components/schemas/TerminalInfo"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "access_token",
          "token_type",
          "company",
          "terminal"
        ],
        "title": "KioskTokenOut"
      },
      "LoginReq": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginReq"
      },
      "MessageOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "MessageOut"
      },
      "PinLoginReq": {
        "properties": {
          "pin": {
            "type": "string",
            "title": "Pin"
          },
          "terminal_id": {
            "type": "integer",
            "title": "Terminal Id"
          }
        },
        "type": "object",
        "required": [
          "pin",
          "terminal_id"
        ],
        "title": "PinLoginReq"
      },
      "RefreshReq": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshReq"
      },
      "TerminalInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "tef_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tef Number"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "TerminalInfo"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type"
        ],
        "title": "TokenOut"
      },
      "ValidatePinOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyInfo"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "company"
        ],
        "title": "ValidatePinOut"
      },
      "ValidatePinReq": {
        "properties": {
          "pin": {
            "type": "string",
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "pin"
        ],
        "title": "ValidatePinReq"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login de administradores/operadores (email + senha) e totens (PIN + terminal). Refresh token com rotação e blacklist via Redis."
    }
  ]
}