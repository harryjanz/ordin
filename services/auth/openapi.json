{
  "openapi": "3.1.0",
  "info": {
    "title": "Ordin — Auth Service",
    "description": "Serviço de autenticação da plataforma Ordin.\n\nEmite JWTs com `role` (`admin`, `cashier`, `kiosk`) e `company_id` extraído das credenciais. Todos os demais serviços validam o token JWT gerado aqui.\n\n**Rate limiting:** 5 tentativas erradas de PIN bloqueiam o IP por 15 minutos.\n\n**Tokens:**\n- `admin` / `cashier`: access 15 min + refresh 7 dias (com rotação)\n- `kiosk`: access 4 horas, sem refresh",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/validate-pin": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Validar PIN da empresa",
        "description": "Valida o PIN de uma empresa sem gerar token. Usado pelo frontend para feedback antes de selecionar terminal.",
        "operationId": "validate_pin_auth_validate_pin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidatePinReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatePinOut"
                }
              }
            }
          },
          "401": {
            "description": "PIN inválido"
          },
          "429": {
            "description": "Rate limit atingido — IP bloqueado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/pin-login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login de totem via PIN",
        "description": "Login para totens de autoatendimento. Retorna JWT com `role: kiosk` e validade de 4 horas (sem refresh).",
        "operationId": "pin_login_auth_pin_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinLoginReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KioskTokenOut"
                }
              }
            }
          },
          "401": {
            "description": "PIN ou terminal inválido"
          },
          "429": {
            "description": "Rate limit atingido — IP bloqueado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login de administrador ou operador",
        "description": "Login com email + senha para roles `admin`/`owner`/`manager`/`cashier`. Retorna access token + refresh\ntoken com rotação — ou, se o usuário já tiver duplo fator ativo ou a empresa exigir (ORD-088), um\n`mfa_token` temporário em vez dos tokens finais (ver `POST /auth/login/mfa-verify`). O header\n`X-Device-Trust` (ORD-092), quando presente e reconhecido, pula o segundo fator mesmo assim.",
        "operationId": "login_auth_login_post",
        "parameters": [
          {
            "name": "X-Device-Trust",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Device-Trust"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TokenOut"
                    },
                    {
                      "$ref": "#/components/schemas/MfaRequiredOut"
                    }
                  ],
                  "title": "Response Login Auth Login Post"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "429": {
            "description": "Rate limit atingido"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login/mfa-verify": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Concluir login com o segundo fator (código TOTP ou de backup)",
        "description": "Segundo passo do login quando `/auth/login` retornou `mfa_required`. Aceita tanto o código de 6\ndígitos do app autenticador quanto um dos códigos de backup. Rate limit por tentativa igual ao do PIN.",
        "operationId": "login_mfa_verify_auth_login_mfa_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Código inválido, ou mfa_token inválido/expirado"
          },
          "429": {
            "description": "Rate limit atingido"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Renovar access token",
        "description": "Rotaciona o refresh token: invalida o token atual e emite um novo par access + refresh.",
        "operationId": "refresh_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Token revogado ou expirado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Logout — revogar refresh token",
        "description": "Revoga o refresh token informado. O access token expira naturalmente no TTL.",
        "operationId": "logout_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/device/challenge": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Gerar código de pareamento para totem",
        "description": "Gera um código de 6 caracteres + QR URL para parear o totem sem PIN.",
        "operationId": "device_challenge_auth_device_challenge_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceChallengeOut"
                }
              }
            }
          }
        }
      }
    },
    "/auth/device/status": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Verificar status do pareamento",
        "description": "Polling pelo totem (ou painel, ORD-119). Retorna pending/approved/expired.\nQuando approved, gera JWT e consome o código. `kind` no payload do Redis\n(gravado por approve_device/approve_panel no company-service) decide o\nformato do token: totem ganha `terminal` + role \"kiosk\"; painel não tem\nterminal (não é ponto de venda) e ganha role \"painel\", só com company_id.",
        "operationId": "device_status_auth_device_status_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Código de 6 caracteres",
              "title": "Code"
            },
            "description": "Código de 6 caracteres"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Healthcheck",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailableTerminalInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "terminal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Code"
          },
          "tef_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tef Number"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "AvailableTerminalInfo"
      },
      "CompanyInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "plan": {
            "type": "string",
            "title": "Plan"
          },
          "visual_theme": {
            "type": "string",
            "title": "Visual Theme",
            "default": "ordin"
          },
          "visual_mode": {
            "type": "string",
            "title": "Visual Mode",
            "default": "light"
          },
          "consumption_mode_enabled": {
            "type": "boolean",
            "title": "Consumption Mode Enabled",
            "default": false
          },
          "catalog_menu_layout": {
            "type": "string",
            "title": "Catalog Menu Layout",
            "default": "horizontal"
          },
          "fulfillment_mode": {
            "type": "string",
            "title": "Fulfillment Mode",
            "default": "por_item"
          },
          "prep_urgency_minutes": {
            "type": "integer",
            "title": "Prep Urgency Minutes",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "plan"
        ],
        "title": "CompanyInfo"
      },
      "DeviceChallengeOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "qr_url": {
            "type": "string",
            "title": "Qr Url"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "code",
          "qr_url",
          "expires_in"
        ],
        "title": "DeviceChallengeOut"
      },
      "DeviceStatusOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token"
          },
          "token_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Type"
          },
          "company": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompanyInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "terminal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TerminalInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DeviceStatusOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "redis"
        ],
        "title": "HealthOut"
      },
      "KioskTokenOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyInfo"
          },
          "terminal": {
            "$ref": "#/components/schemas/TerminalInfo"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "access_token",
          "token_type",
          "company",
          "terminal"
        ],
        "title": "KioskTokenOut"
      },
      "LoginReq": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginReq"
      },
      "MessageOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "MessageOut"
      },
      "MfaRequiredOut": {
        "properties": {
          "mfa_required": {
            "type": "boolean",
            "title": "Mfa Required",
            "default": true
          },
          "mfa_status": {
            "type": "string",
            "title": "Mfa Status"
          },
          "mfa_token": {
            "type": "string",
            "title": "Mfa Token"
          }
        },
        "type": "object",
        "required": [
          "mfa_status",
          "mfa_token"
        ],
        "title": "MfaRequiredOut"
      },
      "MfaVerifyReq": {
        "properties": {
          "mfa_token": {
            "type": "string",
            "title": "Mfa Token"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "trust_device": {
            "type": "boolean",
            "title": "Trust Device",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "mfa_token",
          "code"
        ],
        "title": "MfaVerifyReq"
      },
      "PinLoginReq": {
        "properties": {
          "pin": {
            "type": "string",
            "title": "Pin"
          },
          "terminal_id": {
            "type": "integer",
            "title": "Terminal Id"
          }
        },
        "type": "object",
        "required": [
          "pin",
          "terminal_id"
        ],
        "title": "PinLoginReq"
      },
      "RefreshReq": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshReq"
      },
      "TerminalInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "tef_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tef Number"
          },
          "payment_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Provider"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "TerminalInfo"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          },
          "device_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Token"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type"
        ],
        "title": "TokenOut"
      },
      "ValidatePinOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyInfo"
          },
          "terminals": {
            "items": {
              "$ref": "#/components/schemas/AvailableTerminalInfo"
            },
            "type": "array",
            "title": "Terminals",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "ok",
          "company"
        ],
        "title": "ValidatePinOut"
      },
      "ValidatePinReq": {
        "properties": {
          "pin": {
            "type": "string",
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "pin"
        ],
        "title": "ValidatePinReq"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login de administradores/operadores (email + senha) e totens (PIN + terminal). Refresh token com rotação e blacklist via Redis."
    }
  ]
}