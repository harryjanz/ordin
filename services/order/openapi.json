      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "title": "HealthOut"
      },
      "ItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "name",
          "qty",
          "unit_price"
        ],
        "title": "ItemIn"
      },
      "OrderIn": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemIn"
            },
            "type": "array",
            "title": "Items"
          },
          "cpf": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpf"
          },
          "discount": {
            "type": "number",
            "title": "Discount",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "OrderIn"
      },
      "OrderListItem": {
        "properties": {
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "terminal_id": {
            "type": "integer",
            "title": "Terminal Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "tickets_total": {
            "type": "integer",
            "title": "Tickets Total"
          },
          "tickets_collected": {
            "type": "integer",
            "title": "Tickets Collected"
          }
        },
        "type": "object",
        "required": [
          "order_ref",
          "status",
          "total",
          "terminal_id",
          "created_at",
          "tickets_total",
          "tickets_collected"
        ],
        "title": "OrderListItem"
      },
      "OrderListOut": {
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/OrderListItem"
            },
            "type": "array",
            "title": "Orders"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "orders",
          "total"
        ],
        "title": "OrderListOut"
      },
      "OrderOut": {
        "properties": {
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "order_ref",
          "total",
          "status"
        ],
        "title": "OrderOut"
      },
      "OrderStatusOut": {
        "properties": {
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "order_ref",
          "status"
        ],
        "title": "OrderStatusOut"
      },
      "TicketListOut": {
        "properties": {
