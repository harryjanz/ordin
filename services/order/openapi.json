    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Pedidos",
      "description": "Criação de pedidos pelo totem e acompanhamento do status."
    },
    {
      "name": "Tickets",
      "description": "Coleta de tickets por QR Code. Cada unidade de item gera um ticket independente. Usa `SELECT FOR UPDATE` para prevenir dupla coleta em ambientes multi-device."
    }
  ]
}