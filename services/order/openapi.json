        },
        "type": "object",
        "required": [
          "order_ref",
          "progress",
          "tickets"
        ],
        "title": "TicketListOut"
      },
      "TicketOut": {
        "properties": {
          "ticket_code": {
            "type": "string",
            "title": "Ticket Code"
          },
          "qr_data": {
            "type": "string",
            "title": "Qr Data"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "unit_number": {
            "type": "integer",
            "title": "Unit Number"
          },
          "total_units": {
            "type": "integer",
            "title": "Total Units"
          },
          "collected_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected At"
          },
          "collected_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected By"
          }
        },
        "type": "object",
        "required": [
          "ticket_code",
          "qr_data",
          "status",
          "unit_number",
          "total_units"
        ],
        "title": "TicketOut"
      },
      "ValidationError": {
