{
  "openapi": "3.1.0",
  "info": {
    "title": "Ordin — Order Service",
    "description": "Serviço de pedidos da plataforma Ordin.\n\nGerencia o ciclo completo de um pedido: criação pelo totem, geração de tickets por unidade de item com QR Code assinado (**HMAC-SHA256**), coleta pelo operador de balcão e finalização automática quando todos os tickets forem coletados.\n\n**Prevenção de dupla coleta:** `SELECT FOR UPDATE` no endpoint de coleta.\n\n**QR Code:** `{ticket_code}|{product_name}|{order_ref}|{timestamp}|{HMAC-SHA256}`\n\n**Autenticação:** todos os endpoints exigem `Authorization: Bearer <token>`. Os endpoints `/internal/*` exigem `X-Internal-Secret` e são bloqueados no Kong.",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Criar pedido",
        "description": "Cria um pedido para o totem autenticado. Para cada unidade de cada item, gera um ticket\nindependente com QR Code assinado por HMAC-SHA256. Requer `role: kiosk`.",
        "operationId": "create_order_orders_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Listar pedidos da empresa",
        "description": "Lista pedidos da empresa autenticada com filtro opcional de status.",
        "operationId": "list_orders_orders_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Skip"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_code}/collect": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Coletar ticket via QR Code",
        "description": "Registra a coleta de um ticket. Valida o HMAC do QR Code antes de acessar o banco.\nUsa `SELECT FOR UPDATE` para evitar dupla coleta em ambientes multi-device.\nQuando o último ticket de um pedido é coletado, o pedido é marcado como `completed` automaticamente.\nRequer `role: cashier` ou `admin`.",
        "operationId": "collect_ticket_tickets__ticket_code__collect_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket Code"
            }
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Device-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectOut"
                }
              }
            }
          },
          "400": {
            "description": "QR Code inválido ou assinatura HMAC incorreta"
          },
          "404": {
            "description": "Ticket não encontrado"
          },
          "409": {
            "description": "Ticket já coletado"
          },
          "410": {
            "description": "Ticket expirado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_ref}/status": {
      "patch": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Atualizar status do pedido",
        "description": "Atualiza o status de um pedido. Requer `role: admin`.",
        "operationId": "update_status_orders__order_ref__status_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatusOut"
                }
              }
            }
          },
          "404": {
            "description": "Pedido não encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_ref}/tickets": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Listar tickets de um pedido",
        "description": "Retorna todos os tickets de um pedido com progresso de coleta. Isolamento multi-tenant aplicado.",
        "operationId": "list_order_tickets_orders__order_ref__tickets_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketListOut"
                }
              }
            }
          },
          "404": {
            "description": "Pedido não encontrado ou de outra empresa"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Healthcheck",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollectIn": {
