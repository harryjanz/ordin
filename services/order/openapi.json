                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected By",
            "default": "balcao"
          },
          "collection_device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Device"
          },
          "qr_data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Data"
          }
        },
        "type": "object",
        "title": "CollectIn"
      },
      "CollectOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "ticket_code": {
            "type": "string",
            "title": "Ticket Code"
          },
          "order_ref": {
            "type": "string",
            "title": "Order Ref"
          },
          "collected_at": {
            "type": "string",
            "title": "Collected At"
          },
          "collected_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected By"
          },
          "order_completed": {
            "type": "boolean",
            "title": "Order Completed"
          },
          "progress": {
            "type": "string",
            "title": "Progress"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "ticket_code",
          "order_ref",
          "collected_at",
          "order_completed",
          "progress"
        ],
