{
  "openapi": "3.1.0",
  "info": {
    "title": "Ordin — Catalog Service",
    "description": "Serviço de catálogo de produtos da plataforma Ordin.\n\nExpõe o cardápio de cada empresa para os totens de autoatendimento e painel administrativo. O isolamento multi-tenant é garantido pelo `company_id` extraído do JWT — nunca aceito via query string ou body.\n\n**Autenticação:** todos os endpoints exigem `Authorization: Bearer <token>`.",
    "version": "1.0.0"
  },
  "paths": {
    "/catalog/categories": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Listar categorias do cardápio",
        "description": "Retorna categorias da empresa autenticada. Por padrão só as ativas\n(usado pelo totem); `include_inactive=true` também traz as desativadas\n(usado pela gestão de catálogo no admin). Categorias excluídas\ndefinitivamente (`deleted=True`) nunca aparecem, nem com include_inactive.",
        "operationId": "list_categories_catalog_categories_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Inactive"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Criar categoria",
        "operationId": "create_category_catalog_categories_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/products": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Listar produtos do cardápio",
        "description": "Retorna produtos da empresa. Filtrável por `category_id`. Por padrão só\nprodutos ativos (usado pelo totem); `include_inactive=true` também traz os\ndesativados (usado pela gestão de catálogo no admin). Produtos excluídos\ndefinitivamente (`deleted=True`) nunca aparecem, nem com include_inactive.",
        "operationId": "list_products_catalog_products_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category Id"
            }
          },
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Inactive"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Criar produto",
        "operationId": "create_product_catalog_products_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "400": {
            "description": "category_id não pertence à empresa"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/products/{product_id}": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Detalhes de um produto",
        "description": "Retorna os detalhes de um produto. Isolamento multi-tenant aplicado: 404 se o produto for de outra empresa.",
        "operationId": "get_product_catalog_products__product_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "404": {
            "description": "Produto não encontrado ou de outra empresa"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Editar produto",
        "operationId": "update_product_catalog_products__product_id__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "400": {
            "description": "category_id não pertence à empresa"
          },
          "404": {
            "description": "Produto não encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Desativar ou excluir definitivamente um produto",
        "description": "Por padrão só desativa (`active=False`), reversível via PUT com\n`active: true`. Com `permanent=true`, marca `deleted=True` — ação\nirreversível, nunca mais aparece em nenhuma consulta, mas continua no\nbanco (vínculo com vendas já realizadas). Também remove a imagem do bucket.",
        "operationId": "delete_product_catalog_products__product_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          },
          {
            "name": "permanent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Permanent"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Produto não encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/allergens": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Listar alérgenos oficiais (RDC 727/2022)",
        "description": "Master data, não filtrado por empresa. Fonte das opções de multiseleção\nno admin — a lista nunca fica hardcoded em código (ver ORD-075).",
        "operationId": "list_allergens_catalog_allergens_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllergenListOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
