# ─── Banco de dados (um DB_URL por serviço) ──────────────────────────────────
AUTH_DB_URL=mysql+aiomysql://fk_auth:SENHA_AQUI@mysql:3306/fk_auth?charset=utf8mb4
COMPANY_DB_URL=mysql+aiomysql://fk_company:SENHA_AQUI@mysql:3306/fk_company?charset=utf8mb4
CATALOG_DB_URL=mysql+aiomysql://fk_catalog:SENHA_AQUI@mysql:3306/fk_catalog?charset=utf8mb4
ORDER_DB_URL=mysql+aiomysql://fk_order:SENHA_AQUI@mysql:3306/fk_order?charset=utf8mb4
PAYMENT_DB_URL=mysql+aiomysql://fk_payment:SENHA_AQUI@mysql:3306/fk_payment?charset=utf8mb4

# ─── MySQL root (apenas docker-compose local) ─────────────────────────────────
MYSQL_ROOT_PASSWORD=SENHA_AQUI

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=GERE_COM_openssl_rand_hex_32
JWT_ACCESS_EXP_MINUTES=60
JWT_REFRESH_EXP_DAYS=7

# ─── QR Code ──────────────────────────────────────────────────────────────────
QR_SECRET=GERE_COM_openssl_rand_hex_32

# ─── Comunicação interna ──────────────────────────────────────────────────────
COMPANY_SERVICE_URL=http://company-service:8002
ORDER_SERVICE_URL=http://order-service:8004
INTERNAL_SECRET=GERE_COM_openssl_rand_hex_32

# ─── CORS (portas dos frontends Vite em dev local) ────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── RabbitMQ (local) / SQS (produção) ───────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MESSAGE_BROKER=rabbitmq   # rabbitmq (local) | sqs (produção)

# ─── Criptografia de credenciais TEF (company-service) ───────────────────────
# Gere com: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=GERE_COM_openssl_rand_hex_32

# ─── MongoDB — auditoria de pagamentos (payment-service) ─────────────────────
MONGO_PASSWORD=SENHA_AQUI
MONGO_URL=mongodb://ordin:SENHA_AQUI@mongo:27017/
MONGO_DB=ordin_audit

# ─── Armazenamento de contratos — MinIO (local) / S3 (produção) ─────────────
# S3_ENDPOINT_URL setado = usa MinIO local. Em produção, deixar sem valor
# (ou não definir a variável) para o boto3 usar o endpoint real da AWS com
# credenciais via IAM role — nunca access key/secret key fixas em produção.
S3_BUCKET=ordin-contracts
S3_ENDPOINT_URL=http://minio:9000
# URL alcançável pelo navegador do usuário (não o nome do serviço Docker) —
# usada só pra gerar o link de download, nunca pras chamadas internas do
# company-service.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ordin
S3_SECRET_KEY=SENHA_AQUI
MINIO_ROOT_USER=ordin
MINIO_ROOT_PASSWORD=SENHA_AQUI
AWS_REGION=us-east-1
