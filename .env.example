# ─── Banco de dados (um DB_URL por serviço) ──────────────────────────────────
AUTH_DB_URL=mysql+aiomysql://fk_auth:SENHA_AQUI@mysql:3306/fk_auth?charset=utf8mb4
COMPANY_DB_URL=mysql+aiomysql://fk_company:SENHA_AQUI@mysql:3306/fk_company?charset=utf8mb4
CATALOG_DB_URL=mysql+aiomysql://fk_catalog:SENHA_AQUI@mysql:3306/fk_catalog?charset=utf8mb4
ORDER_DB_URL=mysql+aiomysql://fk_order:SENHA_AQUI@mysql:3306/fk_order?charset=utf8mb4
PAYMENT_DB_URL=mysql+aiomysql://fk_payment:SENHA_AQUI@mysql:3306/fk_payment?charset=utf8mb4

# ─── MySQL root (apenas docker-compose local) ─────────────────────────────────
MYSQL_ROOT_PASSWORD=SENHA_AQUI

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=GERE_COM_openssl_rand_hex_32
JWT_ACCESS_EXP_MINUTES=60
JWT_REFRESH_EXP_DAYS=7

# ─── QR Code ──────────────────────────────────────────────────────────────────
QR_SECRET=GERE_COM_openssl_rand_hex_32

# ─── Comunicação interna ──────────────────────────────────────────────────────
COMPANY_SERVICE_URL=http://company-service:8002
ORDER_SERVICE_URL=http://order-service:8004
INTERNAL_SECRET=GERE_COM_openssl_rand_hex_32

# ─── CORS (portas dos frontends Vite em dev local) ────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── RabbitMQ (local) ─────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ordin:SENHA_AQUI@rabbitmq:5672/

# ─── PayGo TEF ────────────────────────────────────────────────────────────────
PAYGO_MODE=mock
PAYGO_SERVER_URL=http://localhost:8085
PAYGO_TOKEN=TOKEN_AQUI
