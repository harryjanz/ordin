# Ordin — variáveis de ambiente (desenvolvimento local)
# Em produção todos estes valores vivem no AWS Secrets Manager

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=foodkiosk123

# ── Conexões por serviço (usuários isolados por schema) ───────────────────────
AUTH_DB_URL=mysql+aiomysql://fk_auth:auth_pass@mysql:3306/fk_auth
COMPANY_DB_URL=mysql+aiomysql://fk_company:company_pass@mysql:3306/fk_company
CATALOG_DB_URL=mysql+aiomysql://fk_catalog:catalog_pass@mysql:3306/fk_catalog
ORDER_DB_URL=mysql+aiomysql://fk_order:order_pass@mysql:3306/fk_order
PAYMENT_DB_URL=mysql+aiomysql://fk_payment:payment_pass@mysql:3306/fk_payment

# ── Segredos ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-local-apenas
JWT_ACCESS_EXP_MINUTES=60
JWT_REFRESH_EXP_DAYS=7
INTERNAL_SECRET=dev-internal-secret-local
QR_SECRET=dev-qr-secret-local

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── URLs internas entre serviços ──────────────────────────────────────────────
COMPANY_SERVICE_URL=http://company-service:8002
ORDER_SERVICE_URL=http://order-service:8004
PAYMENT_SERVICE_URL=http://payment-service:8005

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ (local) ──────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ── PayGo TEF (simulado) ──────────────────────────────────────────────────────
PAYGO_SERVER_URL=http://localhost:8085
PAYGO_TOKEN=token-mock
